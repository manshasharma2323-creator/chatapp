# ============================================================
# Example environment configuration for the AI Chat Hub backend.
#
# This file documents every environment variable the app reads —
# it contains PLACEHOLDERS ONLY, never real credentials.
#
# Spring Boot does not load .env files automatically. To use this:
#   - copy it (`cp .env.example .env`), fill in real local values, and
#     load it into your shell before running (e.g. via `export $(cat .env
#     | xargs)`, direnv, or your IDE's run-configuration env vars), OR
#   - just set these as real environment variables directly, OR
#   - set them as environment variables in your hosting platform's
#     dashboard (Render/Railway/Fly.io/etc.) when deploying.
#
# Whichever you choose, NEVER commit a file that contains real values —
# .gitignore already excludes `.env` for this reason.
# ============================================================

# ---- Server ----
# Port the backend listens on. Most PaaS hosts (Render, Railway, Heroku)
# inject this automatically at runtime — you usually don't need to set it
# yourself except for local testing.
PORT=8080

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/ai_chat_app
DB_USERNAME=root
DB_PASSWORD=your-mysql-password-here

# ---- JWT ----
# Must be a long, random, secret string before deploying — never reuse
# the example value below. Generate one with e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying

# ---- CORS ----
# Comma-separated list of origins allowed to call the API / open a
# WebSocket connection. Include your deployed frontend's exact origin
# (scheme + host, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5500,https://your-frontend.vercel.app

# ---- AI provider ----
# "openai", "ollama", or "auto" (default) to pick openai automatically
# when a real OPENAI_API_KEY is set, otherwise ollama.
APP_AI_PROVIDER=auto

# Only needed if using the openai provider. Never commit a real key.
OPENAI_API_KEY=sk-replace-with-your-real-openai-api-key

# Only needed if Ollama isn't running on the same machine as the backend.
OLLAMA_BASE_URL=http://localhost:11434

# How long (seconds) to wait for the AI before falling back / erroring.
AI_SMART_REPLY_TIMEOUT_SECONDS=12
AI_ASSISTANT_TIMEOUT_SECONDS=35
